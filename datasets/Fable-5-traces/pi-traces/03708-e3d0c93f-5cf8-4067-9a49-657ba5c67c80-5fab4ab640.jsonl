orderedSegmentIndex(visualOrder, count){\n        if(order === 'reverse') return count - 1 - visualOrder;\n        if(order === 'inside-out' || order === 'outside-in'){\n          const center = (count - 1) / 2;\n          const sorted = [...Array(count).keys()].sort((a,b) => {\n            return order === 'inside-out'\n              ? Math.abs(a - center) - Math.abs(b - center)\n              : Math.abs(b - center) - Math.abs(a - center);\n          });\n          return sorted[visualOrder];\n        }\n        return visualOrder;\n      }\n      requestAnimationFrame(() => {\n        const lengths = candidates.map(lengthOf);\n        const requestedTotal = candidates.reduce((sum, el, i) => {\n          return sum + Math.max(1, Math.min(splitPieces, Math.ceil(lengths[i] / 2)));\n        }, 0);\n        const capScale = requestedTotal > MAX_SEGMENTS ? MAX_SEGMENTS / requestedTotal : 1;\n        let maxEndTime = 0;\n        candidates.forEach((el, pathIndex) => {\n          const len = lengths[pathIndex];\n          const rawPieces = Math.max(1, Math.min(splitPieces, Math.ceil(len / 2)));\n          const pieces = Math.max(1, Math.floor(rawPieces * capScale));\n          const parent = el.parentNode;\n          const group = document.createElementNS('http://www.w3.org/2000/svg','g');\n          parent.insertBefore(group, el.nextSibling);\n          el.classList.add('ai-fill-source-202606');\n          const chunk = len / pieces;\n          const internalStep = pieces > 1 ? (duration * 0.82) / pieces : 0;\n          const segDuration = pieces > 1 ? Math.max(0.06, Math.min(0.4, duration / pieces * 1.55)) : duration;\n          const pathDelay = pathIndex * pathStagger;\n          for(let visualOrder = 0; visualOrder < pieces; visualOrder++){\n            const segIndex = orderedSegmentIndex(visualOrder, pieces);\n            const start = segIndex * chunk;\n            const segLen = segIndex === pieces - 1 ? (len - start) : chunk;\n            const clone = el.cloneNode(true);\n            clone.removeAttribute('id');\n            clone.removeAttribute('aria-label');\n            clone.classList.remove('ai-fill-source-202606');\n            clone.classList.add('ai-draw-segment-202606');\n            clone.setAttribute('aria-hidden','true');\n            clone.style.setProperty('--path-length', len.toFixed(3));\n            clone.style.setProperty('--segment-length', Math.max(0.01, segLen + 0.35).toFixed(3));\n            clone.style.setProperty('--dash-offset', (-start).toFixed(3));\n            clone.style.setProperty('--delay', (pathDelay + visualOrder * internalStep).toFixed(3) + 's');\n            clone.style.setProperty('--segment-duration', segDuration.toFixed(3) + 's');\n            group.appendChild(clone);\n            maxEndTime = Math.max(maxEndTime, pathDelay + visualOrder * internalStep + segDuration);\n          }\n        });\n        root.style.setProperty('--draw-end', Math.max(0, maxEndTime - 0.05).toFixed(3) + 's');\n        root.style.setProperty('--sweep-delay', (maxEndTime + 0.15).toFixed(3) + 's');\n        const wordmark = root.querySelector('.ai-wordmark-202606');\n        if (wordmark) {\n          wordmark.setAttribute('aria-label', wordmark.textContent.replace(/ /g, ' ').trim());\n          const wordStart = maxEndTime + 0.35;\n          const letterStep = 0.045;\n          let letterIndex = 0;\n          wordmark.querySelectorAll('span').forEach(word => {\n            const letters = [...word.textContent];\n            word.textContent = '';\n            letters.forEach(ch => {\n              const span = document.createElement('span');\n              span.className = 'ai-letter-202606';\n              span.setAttribute('aria-hidden', 'true');\n              span.textContent = ch;\n              span.style.setProperty('--delay', (wordStart + letterIndex * letterStep).toFixed(3) + 's');\n              span.style.setProperty('--shimmer-delay', (wordStart + 1.0 + letterIndex * 0.06).toFixed(3) + 's');\n              word.appendChild(span);\n              letterIndex++;\n            });\n          });\n        }\n      });\n    })();\n  </script>\n</div>\n\n    <h1 class=\"cli-name\">g l i n t<span class=\"accent\">_</span></h1>\n    <p class=\"tagline\">a tiny agent that punches above its weight.<br/>A free, terminal-native coding agent by Glint Research.</p>\n    <span class=\"free-badge\">$0.00 · forever</span>\n    <div class=\"cta-row\">\n      <a class=\"btn primary\" href=\"#install\">Install</a>\n      <a class=\"btn\" href=\"#features\">Features</a>\n      <a class=\"btn\" href=\"https://huggingface.co/Glint-Research\">Hugging Face ↗</a>\n    </div>\n  </div>\n</header>\n\n<section id=\"demo\">\n  <div class=\"wrap\">\n    <h2>It lives in your <span class=\"accent\">terminal</span></h2>\n    <p class=\"section-sub\">An inline TUI in the classic style — your scrollback stays yours. No alternate screens, no mouse traps, no ceremony. Type, watch it work, read the answer.</p>\n    <div class=\"term\">\n      <div class=\"term-bar\"><i></i><i></i><i></i></div>\n      <pre><span class=\"t-or\">✦ glint</span> <span class=\"t-dim\">v1.0.0 · Glint Research · a tiny agent that punches above its weight</span>\n<span class=\"t-fa\">  groq/compound · session 3a8a98cf · ~/projects/api</span>\n<span class=\"t-fa\">  /help for commands · ! for shell · traces stay local (opt out: /no-diagnostics)</span>\n\n<span class=\"t-or\">❯</span> <span class=\"t-dim\">run the tests, find every bug they expose, fix them all</span>\n\n<span class=\"t-or\">✦</span> Running the test suite to see what fails.\n  <span class=\"t-rd\">⊘</span> bash <span class=\"t-dim\">python test_calc.py</span>\n    <span class=\"t-fa\">AssertionError: add failed: -1</span>\n  <span class=\"t-gr\">⏺</span> read_file <span class=\"t-dim\">calc.py</span>\n  <span class=\"t-gr\">⏺</span> edit_file <span class=\"t-dim\">calc.py</span>\n    <span class=\"t-fa\">edited calc.py (1 replacement)</span>\n  <span class=\"t-gr\">⏺</span> bash <span class=\"t-dim\">python test_calc.py</span>\n    <span class=\"t-fa\">ALL TESTS PASS</span>\n\n<span class=\"t-or\">✦</span> Fixed <span class=\"t-am\">add()</span> — it subtracted instead of adding. Tests verified green.\n\n<span class=\"t-fa\">╭──────────────────────────────────────────────────────────╮</span>\n<span class=\"t-fa\">│</span> <span class=\"t-or\">❯</span> █                                                       <span class=\"t-fa\">│</span>\n<span class=\"t-fa\">╰──────────────────────────────────────────────────────────╯</span>\n<span class=\"t-fa\"> compound · effort high · ctx 6.4k · 38.7k tok · $0.00 · safe · diag on</span></pre>\n    </div>\n  </div>\n</section>\n\n<section id=\"features\">\n  <div class=\"wrap\">\n    <h2>Built to <span class=\"accent\">replace</span> your daily driver</h2>\n    <p class=\"section-sub\">Everything the heavyweight agent CLIs do, in a tool you actually own. Stable first, pretty second — and it's still pretty.</p>\n    <div class=\"grid\">\n      <div class=\"card\"><h3><span class=\"glyph\">✦</span>Actually free</h3><p>Powered by <code>groq/compound</code> on Groq's free tier. No API key dance, no trial countdown, no surprise invoice. The status bar shows <code>$0.00</code> because it is.</p></div>\n      <div class=\"card\"><h3><span class=\"glyph\">✦</span>Real tools, no fabrication</h3><p>Read, write, edit, grep, glob, bash, web search. The engine refuses invented results: claims of work with no executed tool behind them get bounced back with a reality check.</p></div>\n      <div class=\"card\"><h3><span class=\"glyph\">✦</span>Effort modes</h3><p><code>/effort low · medium · high · max</code> — from quick answers (6 tool rounds) to exhaustive sessions (50). You decide how hard the tiny network thinks.</p></div>\n      <div class=\"card\"><h3><span class=\"glyph\">✦</span>Verification built in</h3><p>If glint edits files and tries to conclude without running anything, the loop demands proof first. Tests get run, not narrated.</p></div>\n      <div class=\"card\"><h3><span class=\"glyph\">✦</span>Tamper-evident traces</h3><p>Every agent step lands in a SHA-256 hash-chained JSONL on <em>your</em> disk — the most secure transport is no transport. Review with <code>/diagnostics</code>, opt out with <code>/no-diagnostics</code>.</p></div>\n      <div class=\"card\"><h3><span class=\"glyph\">✦</span>Memory & skills</h3><p>Facts persist across sessions in <code>~/.glint/memory.md</code>. Workflows save as skills that become slash commands — ask glint to remember, ask it to learn.</p></div>\n      <div class=\"card\"><h3><span class=\"glyph\">✦</span>Subagents</h3><p>Delegation to <code>groq/compound-mini</code> keeps the main context lean — read-only workers explore while the boss stays focused.</p></div>\n      <div class=\"card\"><h3><span class=\"glyph\">✦</span>Safe by default</h3><p>Shell commands and writes ask first, with a diff preview. Read-only commands sail through. <code>/yolo</code> when you trust the room.</p></div>\n      <div class=\"card\"><h3><span class=\"glyph\">✦</span>Sessions that survive</h3><p>Every conversation autosaves. <code>/sessions</code> lists them, <code>/resume</code> continues one, auto-compaction keeps long sessions inside the context window.</p></div>\n    </div>\n  </div>\n</section>\n\n<section id=\"install\">\n  <div class=\"wrap\">\n    <h2>Install in <span class=\"accent\">one minute</span></h2>\n    <div class=\"install-box\">\n      <pre><span class=\"c\"># needs bun ≥ 1.3 and imagemagick (for the logo build)</span>\n<span class=\"p\">$</span> git clone https://github.com/Glint-Research/glint-cli && cd glint-cli\n<span class=\"p\">$</span> bun install && bun run build\n<span class=\"p\">$</span> cp dist/glint ~/.local/bin/\n\n<span class=\"c\"># then, anywhere:</span>\n<span class=\"p\">$</span> glint                     <span class=\"c\"># interactive TUI (with the logo intro)</span>\n<span class=\"p\">$</span> glint -p \"fix the tests\"  <span class=\"c\"># headless one-shot</span></pre>\n    </div>\n    <p class=\"footnote\">Ships as a single compiled binary. No Node, no Python, no runtime to babysit. Your data lives in <code style=\"color:var(--amber)\">~/.glint</code> — logs, traces, sessions, memory, skills — and nowhere else.</p>\n  </div>\n</section>\n\n<footer>\n  <div class=\"wrap\">\n    <p class=\"quote\">\"We teach tiny neural networks to think. Sometimes they surprise us.<br/>Sometimes they just output zeros.\"</p>\n    <p>glint · <a href=\"https://huggingface.co/Glint-Research\">Glint Research</a> · built small, on purpose</p>\n  </div>\n</footer>\n\n</body>\n</html>\n"}}],"timestamp":1781838327000}}
