m = smoothstep(0.10, 0.5, foamRaw);\n  float crest = smoothstep(T + 0.02, T + 0.15, dn) * (1.0 - smoothstep(T + 0.15, T + 0.4, dn));\n  crest *= smoothstep(1.3, 3.4, length(vel));\n  float foamAll = clamp(foam + crest * 0.7, 0.0, 1.0);\n  foamAll *= 0.55 + 0.45 * fbm(uv * vec2(uAspect, 1.0) * 42.0 - vel * 0.02 + uTime * 0.15);\n  vec3 foamCol = vec3(0.93, 0.96, 1.0) * (0.55 + 0.45 * max(dot(n, L), 0.0));\n  water = mix(water, foamCol, clamp(foamAll, 0.0, 0.95) * edge);\n\n  vec3 col = mix(bg, water, edge);\n\n  // spray / mist where density is below the surface threshold\n  float mist = smoothstep(0.06, 0.42, dn) * (1.0 - edge);\n  col += mist * vec3(0.8, 0.88, 1.0) * 0.32;\n  col += mist * vec3(1.0, 0.75, 0.5) * 0.18;\n\n  // stirring cursor: soft glass ring\n  if (uObsActive > 0.001) {\n    vec2 od = (uv - uObstacle.xy) * vec2(uAspect, 1.0);\n    float r = length(od) / max(uObstacle.z, 1e-4);\n    float rim = smoothstep(0.18, 0.0, abs(r - 1.0));\n    col += rim * vec3(0.55, 0.75, 1.0) * 0.35 * uObsActive;\n  }\n\n  // vignette, grain, tonemap\n  vec2 vc = (uv - 0.5) * vec2(uAspect * 0.78, 1.0);\n  col *= 1.0 - 0.38 * pow(length(vc) * 1.18, 2.4);\n  col += (hash(uv * 731.7 + fract(uTime) * 13.1) - 0.5) * 0.012;\n  col = pow(aces(col * 1.12), vec3(1.0 / 2.2));\n  frag = vec4(col, 1.0);\n}`;\n\nclass Renderer {\n  constructor(canvas) {\n    this.canvas = canvas;\n    const gl = canvas.getContext(\"webgl2\", { antialias: false, alpha: false });\n    if (!gl) throw new Error(\"WebGL2 is not supported by this browser/GPU.\");\n    this.gl = gl;\n    this.halfFloat = !!gl.getExtension(\"EXT_color_buffer_float\");\n\n    this.splatProg = this.makeProgram(SPLAT_VS, SPLAT_FS);\n    this.compProg  = this.makeProgram(QUAD_VS, COMPOSITE_FS);\n\n    // unit quad + per-instance particle attributes\n    this.vao = gl.createVertexArray();\n    gl.bindVertexArray(this.vao);\n    const corners = new Float32Array([-1,-1, 1,-1, -1,1, 1,1]);\n    const cb = gl.createBuffer();\n    gl.b