 += dot(p, p + 45.32); return fract(p.x * p.y); }\nfloat noise(vec2 p){\n  vec2 i = floor(p), f = fract(p); f = f * f * (3.0 - 2.0 * f);\n  float a = hash(i), b = hash(i + vec2(1, 0)), c = hash(i + vec2(0, 1)), d = hash(i + vec2(1, 1));\n  return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);\n}\nfloat fbm(vec2 p){\n  float v = 0.0, a = 0.5;\n  for (int i = 0; i < 4; i++) { v += a * noise(p); p *= 2.03; a *= 0.5; }\n  return v;\n}\n\nvec3 sky(vec2 uv){\n  vec3 top = vec3(0.045, 0.065, 0.17);\n  vec3 mid = vec3(0.36, 0.17, 0.30);\n  vec3 hor = vec3(0.98, 0.46, 0.17);\n  vec3 c = mix(hor, mid, smoothstep(0.04, 0.45, uv.y));\n  c = mix(c, top, smoothstep(0.35, 0.95, uv.y));\n  // sun\n  vec2 sp = vec2(0.70, 0.56);\n  vec2 d = (uv - sp) * vec2(uAspect, 1.0);\n  float dist = length(d);\n  c += vec3(1.0, 0.76, 0.46) * exp(-dist * 22.0) * 2.3;\n  c += vec3(1.0, 0.50, 0.24) * exp(-dist * 4.5) * 0.55;\n  c += vec3(1.0, 0.60, 0.30) * exp(-abs(uv.y - sp.y) * 30.0) * exp(-dist * 2.0) * 0.25;\n  // stars\n  vec2 sg = floor(uv * vec2(200.0 * uAspect, 200.0));\n  float st = step(0.997, hash(sg)) * smoothstep(0.55, 0.9, uv.y);\n  st *= 0.5 + 0.5 * sin(uTime * 2.0 + hash(sg + 7.0) * 40.0);\n  c += vec3(0.8, 0.85, 1.0) * st * 0.45;\n  // mountain silhouettes\n  float m1 = 0.34 + 0.05*sin(uv.x*5.0 + 1.7) + 0.03*sin(uv.x*11.0 + 4.0) + 0.04*fbm(vec2(uv.x*6.0, 3.7));\n  float m2 = 0.27 + 0.04*sin(uv.x*7.0 + 0.5) + 0.02*sin(uv.x*17.0)       + 0.03*fbm(vec2(uv.x*9.0, 8.2));\n  c = mix(c, vec3(0.16, 0.10, 0.22), smoothstep(m1 + 0.006, m1 - 0.006, uv.y) * 0.92);\n  c = mix(c, vec3(0.09, 0.06, 0.15), smoothstep(m2 + 0.005, m2 - 0.005, uv.y) * 0.96);\n  return c;\n}\n\nfloat dnorm(float d){ return d / (d + 2.0); }\n\nvec3 aces(vec3 x){\n  return clamp((x * (2.51 * x + 0.03)) / (x * (2.43 * x + 0.59) + 0.14), 0.0, 1.0);\n}\n\nvoid main(){\n  vec2 uv = gl_FragCoord.xy / uRes;\n  vec4 fld = texture(uField, uv);\n  float d = fld.r;\n  vec2 vel = fld.gb / max(d, 1e-3);\n  float foamRaw = fld.a / max(d, 