e\n    gl.bindBuffer(gl.ARRAY_BUFFER, this.posBuf);\n    gl.bufferSubData(gl.ARRAY_BUFFER, 0, fluid.pos.subarray(0, N * 2));\n    gl.bindBuffer(gl.ARRAY_BUFFER, this.velBuf);\n    gl.bufferSubData(gl.ARRAY_BUFFER, 0, fluid.vel.subarray(0, N * 2));\n    gl.bindBuffer(gl.ARRAY_BUFFER, this.foamBuf);\n    gl.bufferSubData(gl.ARRAY_BUFFER, 0, fluid.foam.subarray(0, N));\n\n    // pass 1: splat density/velocity/foam field\n    gl.bindFramebuffer(gl.FRAMEBUFFER, this.fbo);\n    gl.viewport(0, 0, this.fieldW, this.fieldH);\n    gl.clearColor(0, 0, 0, 0);\n    gl.clear(gl.COLOR_BUFFER_BIT);\n    gl.enable(gl.BLEND);\n    gl.blendFunc(gl.ONE, gl.ONE);\n    gl.useProgram(this.splatProg);\n    const h = fluid.h;\n    gl.uniform2f(this.u.splat.off, h, h);\n    gl.uniform2f(this.u.splat.span, fluid.worldW - 2 * h, fluid.worldH - 2 * h);\n    gl.uniform1f(this.u.splat.r, 1.6 * h);\n    gl.bindVertexArray(this.vao);\n    gl.drawArraysInstanced(gl.TRIANGLE_STRIP, 0, 4, N);\n    gl.bindVertexArray(null);\n    gl.disable(gl.BLEND);\n\n    // pass 2: composite\n    gl.bindFramebuffer(gl.FRAMEBUFFER, null);\n    gl.viewport(0, 0, this.canvas.width, this.canvas.height);\n    gl.useProgram(this.compProg);\n    gl.activeTexture(gl.TEXTURE0);\n    gl.bindTexture(gl.TEXTURE_2D, this.fieldTex);\n    gl.uniform1i(this.u.comp.field, 0);\n    gl.uniform2f(this.u.comp.res, this.canvas.width, this.canvas.height);\n    gl.uniform2f(this.u.comp.fieldPx, 1 / this.fieldW, 1 / this.fieldH);\n    gl.uniform1f(this.u.comp.time, time);\n    gl.uniform1f(this.u.comp.aspect, this.canvas.width / this.canvas.height);\n    gl.uniform3f(this.u.comp.obstacle, obsUv.x, obsUv.y, obsUv.r);\n    gl.uniform1f(this.u.comp.obsActive, obsUv.fade);\n    gl.drawArrays(gl.TRIANGLES, 0, 3);\n  }\n}\n\n/* ============================================================================\n   MAIN\n============================================================================ */\n(function () {\n  const canvas = document.getElementById(\"c\");\n  const errEl = document.getElementById(\"err\");\n  let renderer;\n  try {\n    renderer = new Renderer(canvas);\n  } catch (e) {\n    errEl.style.display = \"block\";\n    errEl.textContent = e.message;\n    return;\n  }\n\n  const GRID_RES = 64;            // interior cells along the vertical\n  const WORLD_H = 3.0;            // tank interior height, meters\n  const GRAVITY = -9.81;          // m/s²\n  const FLIP_RATIO = 0.9;         // 90% FLIP / 10% PIC\n  const OVER_RELAX = 1.9;\n  const PARTICLE_ITERS = 2;\n\n  let fluid = null;\n  let substeps = 2, pressureIters = 30;\n  let simMsAvg = 5;\n\n  const obstacle = { active: false, x: 0, y: 0, vx: 0, vy: 0, r: 0.30, fade: 0 };\n  const pointer = { x: 0, y: 0, has: false, lastMove: -1e9 };\n\n  function init() {\n    const dpr = Math.min(window.devicePixelRatio || 1, 1.75);\n    canvas.width = Math.max(2, Math.floor(canvas.clientWidth * dpr));\n    canvas.height = Math.max(2, Math.floor(canvas.clientHeight * dpr));\n    const aspect = clamp(canvas.width / canvas.height, 0.5, 2.2);\n\n    const interiorW = WORLD_H * aspect;\n    // capacity: a completely full tank of hex-packed particles, plus margin\n    const hGuess = WORLD_H / GRID_RES, rGuess = 0.3 * hGuess;\n    const maxP = Math.ceil((interiorW * WORLD_H) / (2 * rGuess * Math.sqrt(3) * rGuess)) + 2000;\n\n    fluid = new FlipFluid(interiorW, WORLD_H, GRID_RES, maxP);\n    fluid.fillDamBreak();\n    renderer.allocBuffers(maxP);\n    renderer.resizeField(Math.ceil(canvas.width / 2), Math.ceil(canvas.height / 2));\n    document.getElementById(\"np\").textContent = fluid.numParticles;\n  }\n\n  // world <-> screen mapping (interior of the tank fills the canvas)\n  function screenToWorld(cx, cy) {\n    const rect = canvas.getBoundingClientRect();\n    const h = fluid.h;\n    return {\n      x: h + ((cx - rect.left) / rect.width) * (fluid.worldW - 2 * h),\n      y: h + (1 - (cy - rect.top) / rect.height) * (fluid.worldH - 2 * h),\n    };\n  }\n\n  canvas.addEventListener(\"pointermove\", (e) => {\n    const w = screenToWorld(e.clientX, e.clientY);\n    pointer.x = w.x; pointer.y = w.y; pointer.has = true;\n    pointer.lastMove = performance.now() / 1000;\n  });\n  canvas.addEventListener(\"pointerleave\", () => { pointer.has = false; });\n  canvas.addEventListener(\"pointerdown\", (e) => {\n    const w = screenToWorld(e.clientX, e.clientY);\n    fluid.spawnBlob(w.x, w.y, 0.28);\n    document.getElementById(\"np\").textContent = fluid.numParticles;\n  });\n  window.addEventListener(\"keydown\", (e) => {\n    if (e.key === \"r\" || e.key === \"R\") {\n      fluid.fillDamBreak();\n      document.getElementById(\"np\").textContent = fluid.numParticles;\n    }\n  });\n\n  let resizeTimer = null;\n  window.addEventListener(\"resize\", () => {\n    clearTimeout(resizeTimer);\n    resizeTimer = setTimeout(init, 250);\n  });\n\n  init();\n\n  // FPS metering\n  let frames = 0, lastFpsT = performance.now();\n  let prevObsX = null, prevObsY = null;\n  const t0 = performance.now();\n\n  function frame() {\n    const now = performance.now();\n    const time = (now - t0) / 1000;\n    const dt = 1 / 60;\n\n    // obstacle follows the pointer; active while it is moving\n    const moving = pointer.has && (now / 1000 - pointer.lastMove) < 0.35;\n    if (moving) {\n      if (prevObsX === null) { prevObsX = pointer.x; prevObsY = pointer.y; }\n      const ovx = clamp((pointer.x - prevObsX) / dt, -8, 8);\n      const ovy = clamp((pointer.y - prevObsY) / dt, -8, 8);\n      obstacle.active = true;\n      obstacle.x = pointer.x; obstacle.y = pointer.y;\n      obstacle.vx = ovx; obstacle.vy = ovy;\n      prevObsX = pointer.x; prevObsY = pointer.y;\n      obstacle.fade = Math.min(1, obstacle.fade + dt * 6);\n    } else {\n      obstacle.active = false;\n      prevObsX = prevObsY = null;\n      obstacle.fade = Math.max(0, obstacle.fade - dt * 4);\n    }\n\n    const simStart = performance.now();\n    const sdt = dt / substeps;\n    for (let s = 0; s < substeps; s++)\n      fluid.simulate(sdt, GRAVITY, FLIP_RATIO, pressureIters, PARTICLE_ITERS, OVER_RELAX, obstacle);\n    const simMs = performance.now() - simStart;\n    simMsAvg = simMsAvg * 0.95 + simMs * 0.05;\n    // adapt cost if the machine struggles\n    if (simMsAvg > 12 && substeps === 2) { substeps = 1; pressureIters = 45; }\n    else if (simMsAvg < 5 && substeps === 1) { substeps = 2; pressureIters = 30; }\n\n    const h = fluid.h;\n    renderer.draw(fluid, time, {\n      x: (obstacle.x - h) / (fluid.worldW - 2 * h),\n      y: (obstacle.y - h) / (fluid.worldH - 2 * h),\n      r: obstacle.r / (fluid.worldH - 2 * h),\n      fade: obstacle.fade,\n    });\n\n    frames++;\n    if (now - lastFpsT > 500) {\n      document.getElementById(\"fps\").textContent = Math.round(frames * 1000 / (now - lastFpsT));\n      frames = 0; lastFpsT = now;\n    }\n    requestAnimationFrame(frame);\n  }\n  requestAnimationFrame(frame);\n})();\n</script>\n</body>\n</html>\n"}}],"timestamp":1781838444000}}
