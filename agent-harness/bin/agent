#!/usr/bin/env bash
#
# agent — CLI for the agent-harness.
# Runs the TypeScript CLI via tsx.
#
SCRIPT_SRC="${BASH_SOURCE[0]}"
while [[ -h "$SCRIPT_SRC" ]]; do
  SCRIPT_SRC="$(readlink -f "$SCRIPT_SRC")"
done
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_SRC")" && pwd)"
HARNESS_DIR="$(dirname "$SCRIPT_DIR")"
TSX="$HARNESS_DIR/node_modules/.bin/tsx"
ENTRY="$HARNESS_DIR/src/cli.ts"

if [[ ! -x "$TSX" ]]; then
  exec npx --yes tsx "$ENTRY" "$@"
fi

exec "$TSX" "$ENTRY" "$@"